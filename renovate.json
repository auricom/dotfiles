{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>auricom/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Grok Bot AppImage URL in packages_appimage.yaml",
      "managerFilePatterns": ["/^\\.chezmoidata/packages_appimage\\.yaml$/"],
      "matchStrings": [
        "url:\\s*https://downloads\\.cursor\\.com/grokbot/stable/(?<currentDigest>[a-f0-9]{40})/linux/x64/Grok_Bot_(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.AppImage"
      ],
      "depNameTemplate": "grokbot",
      "datasourceTemplate": "custom.grokbot",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "pnpm pin in the recur distrobox",
      "managerFilePatterns": ["/^dot_config/distrobox/recur\\.ini\\.tmpl$/"],
      "matchStrings": ["pnpm@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "wails3 pin in the recur distrobox",
      "managerFilePatterns": ["/^dot_config/distrobox/recur\\.ini\\.tmpl$/"],
      "matchStrings": [
        "wails3@(?<currentValue>v\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.]+)?)"
      ],
      "depNameTemplate": "github.com/wailsapp/wails/v3",
      "packageNameTemplate": "github.com/wailsapp/wails/v3",
      "datasourceTemplate": "go",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Go toolchain pin in the recur distrobox",
      "managerFilePatterns": ["/^dot_config/distrobox/recur\\.ini\\.tmpl$/"],
      "matchStrings": [
        "GOTOOLCHAIN=go(?<currentValue>\\d+\\.\\d+\\.\\d+)\\+auto"
      ],
      "depNameTemplate": "go",
      "packageNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "mise tool just",
      "managerFilePatterns": ["/^\\.mise/config\\.toml$/"],
      "matchStrings": [
        "(?:^|\\n)just\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "casey/just",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?:v)?(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "mise tool lefthook",
      "managerFilePatterns": ["/^\\.mise/config\\.toml$/"],
      "matchStrings": [
        "(?:^|\\n)lefthook\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "evilmartians/lefthook",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?:v)?(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "mise tool shellcheck",
      "managerFilePatterns": ["/^\\.mise/config\\.toml$/"],
      "matchStrings": [
        "(?:^|\\n)shellcheck\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "koalaman/shellcheck",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?:v)?(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "mise tool shfmt",
      "managerFilePatterns": ["/^\\.mise/config\\.toml$/"],
      "matchStrings": [
        "(?:^|\\n)shfmt\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "mvdan/sh",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?:v)?(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "mise tool oxfmt",
      "managerFilePatterns": ["/^\\.mise/config\\.toml$/"],
      "matchStrings": [
        "(?:^|\\n)oxfmt\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "oxfmt",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    }
  ],
  "customDatasources": {
    "grokbot": {
      "defaultRegistryUrlTemplate": "https://api2.cursor.sh/updates/api/download/stable/linux-x64/sand",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": [ { \"version\": version, \"digest\": commitSha } ] }"
      ]
    }
  },
  "packageRules": [
    {
      "description": "Regex managers own .mise/config.toml so the built-in mise manager does not open a second PR for the same pin.",
      "matchManagers": ["mise"],
      "enabled": false
    }
  ]
}
