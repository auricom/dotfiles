# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# Homebrew (linuxbrew)
if [ -d {{ .brewPrefix }} ]; then
    eval "$({{ .brewPrefix }}/bin/brew shellenv)"
fi

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

# Interactive tools
if [[ $- == *i* ]]; then
    # Clear the previous per-shell selector when reloading an existing session.
    unset -f __apply_terminal_theme __starship_apply_theme
    unset starship_precmd_user_func STARSHIP_CONFIG EZA_CONFIG_DIR

    if command -v starship >/dev/null 2>&1; then
        eval "$(starship init bash)"
    fi

    if command -v eza >/dev/null 2>&1; then
        eza() {
            # Keep desktop LS_COLORS from overriding the Catppuccin theme.
            LS_COLORS= command eza "$@"
        }

        alias ll='eza -l --icons=auto --group-directories-first'
        alias l.='eza -d .*'
        alias ls='eza'
        alias l1='eza -1'
    fi
fi
