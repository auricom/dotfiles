#!/usr/bin/env bash

set -Eeuo pipefail

# shellcheck source=common_utils.sh
source "${HOME}/.local/lib/common_utils.sh"
trap 'report_error "$?" "$LINENO"' ERR

main() {
    require_no_args "Update PiKVM." "$@"
    local status

    require_command ssh "PiKVM updates"

    log_section "Updating PiKVM"
    if ssh -t root@pikvm 'rw && pikvm-update'; then
        log_info "PiKVM update completed"
    else
        status=$?
        log_error "PiKVM update failed"
        return "${status}"
    fi
}

main "$@"
