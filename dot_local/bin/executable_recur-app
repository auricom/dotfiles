#!/usr/bin/env bash

set -Eeuo pipefail

readonly RECUR_BIN="/usr/bin/recur"

# The release build comes from the recur sysext and runs on the host.
# Only the development box still needs distrobox.
if [[ "${1-}" == "--dev" ]]; then
    shift
    # Distrobox must use the host's rootless Podman, not Homebrew's client.
    export PATH="/usr/bin:${PATH}"
    exec distrobox enter --no-tty recur-dev -- "${RECUR_BIN}" "$@"
fi

exec "${RECUR_BIN}" "$@"
