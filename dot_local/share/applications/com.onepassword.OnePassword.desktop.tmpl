[Desktop Entry]
Type=Application
Name=1Password
Comment=Password manager and secure wallet
Exec={{ joinPath .chezmoi.homeDir ".local/bin/1password" }} %U
Icon=1password
Terminal=false
StartupWMClass=com.onepassword.OnePassword
Categories=Office;Security;
MimeType=x-scheme-handler/onepassword;x-scheme-handler/onepassword8;
Actions=QuickAccess;Lock;

[Desktop Action QuickAccess]
Name=Quick Access
Exec={{ joinPath .chezmoi.homeDir ".local/bin/1password" }} --quick-access

[Desktop Action Lock]
Name=Lock 1Password
Exec={{ joinPath .chezmoi.homeDir ".local/bin/1password" }} --lock
