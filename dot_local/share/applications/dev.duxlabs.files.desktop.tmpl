{{- if .isWorkstation }}
[Desktop Entry]
Type=Application
Name=Dux Files
GenericName=File Manager
Comment=File manager for the dux desktop
Exec={{ .brewPrefix }}/bin/mise exec github:duxlabs-dev/dux-files -- dfiles open %U
Icon=dev.duxlabs.files
Terminal=false
Categories=System;FileTools;FileManager;Utility;Qt;
Keywords=files;folders;browse;explorer;
MimeType=inode/directory;
StartupNotify=true
StartupWMClass=dev.duxlabs.files
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec={{ .brewPrefix }}/bin/mise exec github:duxlabs-dev/dux-files -- dfiles open --new-window %U
{{- end }}
