KUBE_EDITOR=nano
VISUAL=nano
EDITOR=nano
HOMEBREW_NO_ANALYTICS=1
ANSIBLE_FORCE_COLOR=true
ANSIBLE_HOST_KEY_CHECKING=False
PY_COLORS=true
# Do not set LC_ALL. It overrides every category, including LANG, and forces
# GUI apps onto the C locale so they lose French dates.
LANG=${LANG:-fr_FR.UTF-8}
LC_TIME=${LC_TIME:-fr_FR.UTF-8}
LC_COLLATE=${LC_COLLATE:-C.UTF-8}
BAT_THEME=auto
BAT_THEME_DARK="Catppuccin Mocha"
BAT_THEME_LIGHT="Catppuccin Latte"
HOMEBREW_PREFIX={{ .brewPrefix }}
HOMEBREW_CELLAR=${HOMEBREW_PREFIX}/Cellar
HOMEBREW_REPOSITORY=${HOMEBREW_PREFIX}
PATH=${HOME}/.local/bin:${HOMEBREW_PREFIX}/bin:${PATH}:${HOME}/.krew/bin

# Clear the previous fixed palette; fzf reads the active file on each invocation.
FZF_DEFAULT_OPTS=""
FZF_DEFAULT_OPTS_FILE=${HOME}/.config/terminal-themes/fzf/active.opts
