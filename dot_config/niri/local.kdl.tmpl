layout {
    default-column-width { proportion {{ .niri.column_width }}; }
    gaps {{ .niri.gaps }}
}

binds {
    Ctrl+Shift+Space hotkey-overlay-title="1Password Quick Access" { spawn "{{ joinPath .chezmoi.homeDir ".local/bin/1password" }}" "--quick-access"; }
    Mod+Alt+T hotkey-overlay-title="Toggle light/dark" { spawn "dms" "ipc" "call" "theme" "toggle"; }
    Mod+E hotkey-overlay-title="Open Dux Files" { spawn "{{ joinPath .chezmoi.homeDir ".local/share/mise/shims/dfiles" }}" "open"; }
    Mod+P hotkey-overlay-title="Print screen" { spawn-sh "dms screenshot"; }
    XF86AudioLowerVolume { spawn "dms" "ipc" "call" "audio" "decrement" "5"; }
    XF86AudioMute { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioNext { spawn "dms" "ipc" "call" "mpris" "next"; }
    XF86AudioPause { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPlay { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPrev { spawn "dms" "ipc" "call" "mpris" "previous"; }
    XF86AudioRaiseVolume { spawn "dms" "ipc" "call" "audio" "increment" "5"; }
    XF86MonBrightnessDown { spawn "dms" "ipc" "call" "brightness" "decrement" "5"; }
    XF86MonBrightnessUp { spawn "dms" "ipc" "call" "brightness" "increment" "5"; }
    XF86Tools { spawn "dms" "ipc" "call" "audio" "micmute"; }
}

input {
    keyboard {
        xkb {
              layout "us_qwerty-fr"
              file "{{ joinPath .chezmoi.homeDir ".config/xkb/symbols/us_qwerty-fr" }}"
        }
    }
}

workspace "chat"
workspace "games"

window-rule {
    match app-id=r#"^com\.slack\.Slack$"#
    match app-id=r#"^org\.telegram\.desktop$"#
    match app-id=r#"^dev\.vencord\.Vesktop$"#
    match app-id=r#"^vesktop$"#
    match app-id=r#"^com\.rtosta\.zapzap$"#
    match app-id=r#"^zapzap$"#

    open-on-workspace "chat"
}

window-rule {
    match app-id=r#"^com\.valvesoftware\.Steam$"#
    match app-id=r#"^steam$"#

    open-on-workspace "games"
}

window-rule {
    match app-id=r#"^app.zen_browser.zen$"# title=r#"^(Picture-in-Picture|Library)$"#

    open-floating true
}

window-rule {
    match app-id=r#"^dev.duxlabs.files$"# title=r#"^(Open Folder)$"#

    open-floating true
}

window-rule {
    match app-id=r#"^(1Password|com\.onepassword\.OnePassword)$"# title=r#"Quick Access"#

    open-floating true
}

{{ if .isLaptop -}}
window-rule {
    match app-id=r#"^dev\.zed\.Zed$"#

    open-fullscreen false
    open-maximized-to-edges true
}

{{ end -}}
window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#

    open-maximized false
    open-floating true
    default-column-width { proportion 0.08; }
    default-window-height { fixed 500; }
}
