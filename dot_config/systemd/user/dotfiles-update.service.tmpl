{{ includeTemplate "systemd-oneshot" (dict
    "description" "dotfiles update"
    "after" (list "local-fs.target" "network-online.target")
    "condition" "%h/.local/bin/dotfiles-update"
    "exec" "/usr/bin/bash -c \"%h/.local/bin/dotfiles-update\""
    "path" (includeTemplate "brew-path" . | trim)
) -}}
