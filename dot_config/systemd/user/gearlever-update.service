[Unit]
Description=Gear Lever AppImage update
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/bin/flatpak
OnFailure=notify-failure@%p.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak run it.mijorus.gearlever --update --all --yes

[Install]
WantedBy=default.target
