{{ includeTemplate "systemd-oneshot" (dict
    "description" "distrobox upgrade"
    "after" (list "network-online.target")
    "wants" "network-online.target"
    "condition" "%h/.local/bin/update-distrobox"
    "exec" "/usr/bin/bash -c \"%h/.local/bin/update-distrobox\""
    "path" (printf "/usr/bin:%s" (includeTemplate "brew-path" . | trim))
) -}}
