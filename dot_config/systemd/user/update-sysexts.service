[Unit]
Description=Stage system extension updates for next boot
After=network-online.target
ConditionPathExists=/usr/local/libexec/update-sysexts
OnFailure=notify-failure@%p.service

[Service]
Type=oneshot
ExecStart=/usr/bin/sudo -n /usr/bin/systemctl start update-sysexts.service
# The root updater allows 15 minutes; wait for its completion.
TimeoutStartSec=20min

[Install]
WantedBy=default.target
