[Unit]
Description=Dux Files
Documentation=https://github.com/duxlabs-dev/dux-files
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/share/mise/shims/dfiles run --session --hidden --keep-running
Environment="PATH={{ includeTemplate "brew-path" . | trim }}"
Restart=on-failure
RestartSec=2
Slice=app.slice

[Install]
WantedBy=graphical-session.target
