# Small set of shortcuts; most git shortcuts live in fish abbrs
[alias]
    # Compact graph log with dates and authors
    lg = "log --graph --abbrev-commit --pretty=format:'%C(yellow)%h%C(reset) -%C(auto)%d%C(reset) %s %C(green)(%cr) %C(blue)<%an>%C(reset)'"
    # Undo the last commit, keep its changes staged
    undo = "reset --soft HEAD~"
    # Default branch name from origin/HEAD (`git remote set-head origin --auto` if unset)
    mainormaster = "!git symbolic-ref --short refs/remotes/origin/HEAD | sed 's@^origin/@@'"
    # What the PR will contain, like GitHub's compare view
    diffbranch = "!f() { git diff \"origin/$(git mainormaster)...\" \"$@\"; }; f"
    # Commits on this branch only
    difflog = "!f() { git log --no-merges \"origin/$(git mainormaster)..\" \"$@\"; }; f"

# Makes it a bit more readable
[blame]
    coloring = "repeatedLines"
    markIgnoredLines = true
    markUnblamables = true

[branch]
    # Most recently used branches first
    sort = "-committerdate"

# Shiny colors
[color]
    branch = "auto"
    diff = "auto"
    interactive = "auto"
    status = "auto"
    ui = "auto"

# Pretty much the usual diff colors
[color "diff"]
    commit = "yellow"
    frag = "cyan"
    meta = "yellow"
    new = "green"
    old = "red"
    whitespace = "red reverse"

# List branches, tags, etc. in columns when they fit
[column]
    ui = "auto"

[commit]
    gpgSign = true
    # Show my changes when writing the message
    verbose = true

[core]
    pager = "delta"

[delta]
    features = "diff-highlight decorations"
    # Jump between files with n/N
    navigate = true
    # Dark fallback; the terminal-theme hook overrides it below
    syntax-theme = "Catppuccin_Mocha"

# Light/dark syntax theme selected by the terminal-theme hook
[include]
    path = "~/.config/terminal-themes/delta/active.gitconfig"

# Personal preference for easier reading
[delta "decorations"]
    commit-style = "raw"
    keep-plus-minus-markers = true
    paging = "always"

# Less jarring style for `diff-highlight` emulation
[delta "diff-highlight"]
    minus-emph-style = "bold red 52"
    minus-non-emph-style = "red"
    minus-style = "red"
    plus-emph-style = "bold green 22"
    plus-non-emph-style = "green"
    plus-style = "green"
    whitespace-error-style = "reverse red"

[diff]
    # Faster patience variant, usually cleaner hunks
    algorithm = "histogram"
    # Show moved blocks as moved, not as delete + add
    colorMoved = "plain"
    # Use better, descriptive initials (c, i, w) instead of a/b.
    mnemonicPrefix = true
    # Detect copies as well as renames
    renames = "copies"
    # Display submodule-related information (commit listings)
    submodule = "log"
    # When using --word-diff, assume --word-diff-regex=.
    wordRegex = "."

[fetch]
    prune = true
    pruneTags = true

[filter "lfs"]
    clean = "git-lfs clean -- %f"
    process = "git-lfs filter-process"
    required = true
    smudge = "git-lfs smudge -- %f"

[gpg]
    format = "ssh"

# `git stauts` asks before running `git status`
[help]
    autocorrect = "prompt"

# Local configuration, not-versioned
[include]
    path = "config.local"

[init]
    defaultBranch = "main"

[interactive]
    diffFilter = "delta --color-only"

[merge]
    conflictStyle = "zdiff3"

[mergetool]
    # Clean up backup files created by merge tools on tool exit
    keepBackup = false
    # Clean up temp files created by merge tools on tool exit
    keepTemporaries = false
    # Auto-accept file prompts when launching merge tools
    prompt = false
    # Put the temp files in a dedicated dir anyway
    writeToTemp = true

[pull]
    # Avoid useless merge commits
    rebase = "merges"

[push]
    autoSetupRemote = true
    default = "upstream"
    followTags = true

[rebase]
    autoSquash = true
    autoStash = true
    # Move stacked branches along with the rebased one
    updateRefs = true

# Reuse recorded conflict resolutions
[rerere]
    autoupdate = true
    enabled = true

[status]
    # Display submodule rev change summaries in status
    submoduleSummary = true

[tag]
    sort = "version:refname"

[url "git@github.com:"]
    insteadOf = "https://github.com/"

[url "git@gitlab.com:"]
    insteadOf = "https://gitlab.com/"

[user]
    email = "{{ .gitUser.email }}"
    name = "{{ .gitUser.name }}"
    signingkey = "{{ joinPath .chezmoi.homeDir ".ssh/id_ed25519" }}"
