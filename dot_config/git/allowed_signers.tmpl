{{- $key := joinPath .chezmoi.homeDir ".ssh/id_ed25519" -}}
{{- $pub := printf "%s.pub" $key -}}
{{- $line := "" -}}
{{- if stat $pub -}}
{{-   $line = output "cat" $pub | trim -}}
{{- else if stat $key -}}
{{-   $line = output "ssh-keygen" "-y" "-P" "" "-f" $key | trim -}}
{{- else -}}
{{-   fail (printf "missing SSH key for allowed signers: %s" $key) -}}
{{- end -}}
# Managed by chezmoi from .chezmoidata/git.yaml and ~/.ssh/id_ed25519(.pub).
{{ .gitUser.email }} {{ $line }}
