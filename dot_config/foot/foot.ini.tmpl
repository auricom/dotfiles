shell={{ .brewPrefix }}/bin/fish

term=xterm-256color
title=foot
locked-title=yes
app-id=foot

font=AdwaitaMono Nerd Font Mono:size=13
font-bold=AdwaitaMono Nerd Font:weight=bold:size=13
font-italic=AdwaitaMono Nerd Font:slant=italic:size=13
font-bold-italic=AdwaitaMono Nerd Font:weight=bold:slant=italic:size=13

[cursor]
style=block

[key-bindings]
color-theme-switch-dark=Control+p
color-theme-switch-light=Control+o

{{- $mocha := .catppuccin.palette.mocha }}
{{- $latte := .catppuccin.palette.latte }}

[colors-dark]
cursor={{ $mocha.crust }} {{ $mocha.rosewater }}
foreground={{ $mocha.text }}
background={{ $mocha.base }}

regular0={{ $mocha.surface1 }}
regular1={{ $mocha.red }}
regular2={{ $mocha.green }}
regular3={{ $mocha.yellow }}
regular4={{ $mocha.blue }}
regular5={{ $mocha.pink }}
regular6={{ $mocha.teal }}
regular7={{ $mocha.subtext1 }}

bright0={{ $mocha.surface2 }}
bright1={{ $mocha.red }}
bright2={{ $mocha.green }}
bright3={{ $mocha.yellow }}
bright4={{ $mocha.blue }}
bright5={{ $mocha.pink }}
bright6={{ $mocha.teal }}
bright7={{ $mocha.subtext0 }}

16={{ $mocha.peach }}
17={{ $mocha.rosewater }}

selection-foreground={{ $mocha.text }}
selection-background=414356

search-box-no-match={{ $mocha.crust }} {{ $mocha.red }}
search-box-match={{ $mocha.text }} {{ $mocha.surface0 }}

jump-labels={{ $mocha.crust }} {{ $mocha.peach }}
urls={{ $mocha.blue }}

[colors-light]
cursor={{ $latte.base }} {{ $latte.rosewater }}
foreground={{ $latte.text }}
background={{ $latte.base }}

regular0={{ $latte.subtext1 }}
regular1={{ $latte.red }}
regular2={{ $latte.green }}
regular3={{ $latte.yellow }}
regular4={{ $latte.blue }}
regular5={{ $latte.pink }}
regular6={{ $latte.teal }}
regular7={{ $latte.surface2 }}

bright0={{ $latte.subtext0 }}
bright1={{ $latte.red }}
bright2={{ $latte.green }}
bright3={{ $latte.yellow }}
bright4={{ $latte.blue }}
bright5={{ $latte.pink }}
bright6={{ $latte.teal }}
bright7={{ $latte.surface1 }}

16={{ $latte.peach }}
17={{ $latte.rosewater }}

selection-foreground={{ $latte.text }}
selection-background=ccced7

search-box-no-match={{ $latte.crust }} {{ $latte.red }}
search-box-match={{ $latte.text }} {{ $latte.surface0 }}

jump-labels={{ $latte.crust }} {{ $latte.peach }}
urls={{ $latte.blue }}
