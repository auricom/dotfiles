{{- /* chezmoi:modify-template */ -}}
{{- $raw := .chezmoi.stdin | trim -}}
{{- $data := dict -}}
{{- if $raw -}}
{{-   $data = fromJson $raw -}}
{{- end -}}
{{- $before := toJson $data -}}
{{- $data = setValueAtPath "registryThemeVariants.catppuccin.dark.accent" .catppuccin.accent $data -}}
{{- $data = setValueAtPath "registryThemeVariants.catppuccin.light.accent" .catppuccin.accent $data -}}
{{- if eq $before (toJson $data) -}}
{{- .chezmoi.stdin -}}
{{- else -}}
{{- $data | toPrettyJson }}
{{ end -}}
