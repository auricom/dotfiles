[recur]
image=debian:stable
pull=true
entry=false
additional_packages="ca-certificates curl gh git gnupg gzip jq libgtk-4-1 libwebkitgtk-6.0-4 nodejs npm procps ripgrep tar xdg-utils"
init_hooks="{{ .chezmoi.homeDir }}/.local/libexec/install-recur-release"
init_hooks="install -d -m 0755 /etc/apt/keyrings"
init_hooks="curl -fsSL https://downloads.claude.ai/keys/claude-code.asc -o /etc/apt/keyrings/claude-code.asc"
init_hooks="gpg --show-keys --with-colons /etc/apt/keyrings/claude-code.asc | grep -Fq 'fpr:::::::::31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE:'"
init_hooks="echo deb [signed-by=/etc/apt/keyrings/claude-code.asc] https://downloads.claude.ai/claude-code/apt/stable stable main > /etc/apt/sources.list.d/claude-code.list"
init_hooks="apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends claude-code"
init_hooks="npm install --global @openai/codex@latest"

[recur-dev]
image=debian:stable
pull=true
entry=false
additional_packages="build-essential ca-certificates curl gh git gnupg golang-go gzip jq libgtk-4-dev libwebkitgtk-6.0-dev nodejs npm pkg-config procps ripgrep sqlite3 tar xdg-utils"
init_hooks="{{ .chezmoi.homeDir }}/.local/libexec/install-recur-release"
init_hooks="install -d -m 0755 /etc/apt/keyrings"
init_hooks="curl -fsSL https://downloads.claude.ai/keys/claude-code.asc -o /etc/apt/keyrings/claude-code.asc"
init_hooks="gpg --show-keys --with-colons /etc/apt/keyrings/claude-code.asc | grep -Fq 'fpr:::::::::31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE:'"
init_hooks="echo deb [signed-by=/etc/apt/keyrings/claude-code.asc] https://downloads.claude.ai/claude-code/apt/stable stable main > /etc/apt/sources.list.d/claude-code.list"
init_hooks="apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends claude-code"
init_hooks="npm install --global @openai/codex@latest"
init_hooks="npm install --global pnpm@10.34.3"
init_hooks="GOTOOLCHAIN=go1.26.8+auto GOPATH=/var/lib/recur-go GOCACHE=/var/cache/recur-go-build GOBIN=/usr/local/bin go install github.com/wailsapp/wails/v3/cmd/wails3@v3.0.0-beta.24"
