{{- $m := .catppuccin.palette.mocha -}}
if type -q fzf
    if status is-interactive
        # catppuccin mocha - https://github.com/catppuccin/fzf
        set -Ux FZF_DEFAULT_OPTS "\
        --color=bg+:#{{ $m.surface0 }},bg:#{{ $m.base }},spinner:#{{ $m.rosewater }},hl:#{{ $m.red }} \
        --color=fg:#{{ $m.text }},header:#{{ $m.red }},info:#{{ $m.mauve }},pointer:#{{ $m.rosewater }} \
        --color=marker:#{{ $m.rosewater }},fg+:#{{ $m.text }},prompt:#{{ $m.mauve }},hl+:#{{ $m.red }}"
    end
end
