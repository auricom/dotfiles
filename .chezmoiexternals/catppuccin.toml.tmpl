# Catppuccin themes for various applications

# bat
{{- range .catppuccin.flavors }}
[".config/bat/themes/Catppuccin_{{ .title }}.tmTheme"]
    type = "file"
    url = "https://github.com/catppuccin/bat/raw/main/themes/Catppuccin%20{{ .title }}.tmTheme"
    refreshPeriod = "168h"
{{- end }}

# btop
{{- range .catppuccin.flavors }}
[".config/btop/themes/catppuccin_{{ .id }}.theme"]
    type = "file"
    url = "https://github.com/catppuccin/btop/raw/main/themes/catppuccin_{{ .id }}.theme"
    refreshPeriod = "168h"
{{- end }}

# eza
[".config/eza/theme.yml"]
    type = "file"
    url = "https://raw.githubusercontent.com/catppuccin/eza/refs/heads/main/themes/mocha/catppuccin-mocha-mauve.yml"
    refreshPeriod = "168h"

{{ if .isDesktop }}
# k9s
[".config/k9s/skins"]
    type = "archive"
    url = "https://github.com/catppuccin/k9s/archive/main.tar.gz"
    exact = true
    stripComponents = 2
    refreshPeriod = "168h"

