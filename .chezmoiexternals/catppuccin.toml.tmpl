# zen (Mocha + Latte, Sky accent)
{{- range $title := list "Mocha" "Latte" }}
{{- $id := lower $title }}
{{ includeTemplate "external-file" (dict "path" (printf ".local/share/catppuccin/zen/%s_sky_userChrome.css" $id) "url" (printf "https://raw.githubusercontent.com/catppuccin/zen-browser/refs/heads/main/themes/%s/Sky/userChrome.css" $title)) }}
{{ includeTemplate "external-file" (dict "path" (printf ".local/share/catppuccin/zen/%s_sky_userContent.css" $id) "url" (printf "https://raw.githubusercontent.com/catppuccin/zen-browser/refs/heads/main/themes/%s/Sky/userContent.css" $title)) }}
{{ includeTemplate "external-file" (dict "path" (printf ".local/share/catppuccin/zen/%s_sky_zen-logo.svg" $id) "url" (printf "https://raw.githubusercontent.com/catppuccin/zen-browser/refs/heads/main/themes/%s/Sky/zen-logo-%s.svg" $title $id)) }}
{{- end }}

