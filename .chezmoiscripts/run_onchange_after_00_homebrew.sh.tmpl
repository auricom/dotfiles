{{- includeTemplate "script-header" . }}

# Package installation script
# This script installs packages via Homebrew
# Hash dependencies: {{ include "Brewfile.tmpl" | sha256sum }} {{ include ".chezmoidata/packages_brew.yaml" | sha256sum }} {{ include ".chezmoidata/packages_cask.yaml" | sha256sum }}

main() {
    log_section "Installing Brewfile (Homebrew packages)"

    require_command brew "Homebrew package installation"

    if command_exists brew-proxy; then
        if [[ " $(id -nG "{{ .chezmoi.username }}") " != *" linuxbrew "* ]]; then
            log_info "Granting {{ .chezmoi.username }} unattended Homebrew access"
            sudo usermod -aG linuxbrew "{{ .chezmoi.username }}"
        fi

        # Let brew-proxy/Polkit check access; inherited process groups can be stale.
        # Fail instead of prompting when brew-proxy authorization is unavailable.
        export BREW_PROXY_NONINTERACTIVE=1
    fi

    run_spin "Updating Homebrew..." brew update
    log_info "Homebrew updated"

    run_spin "Installing packages..." brew bundle --file="{{ .chezmoi.homeDir }}/Brewfile"
    log_info "Brewfile installation completed"
    log_info "To remove unlisted packages, run: brew bundle cleanup --file={{ .chezmoi.homeDir }}/Brewfile"
}

{{ includeTemplate "script-footer" . -}}
