{{- includeTemplate "script-header" . }}

# Package installation script
# This script installs packages via Homebrew
# Hash dependencies: {{ include "Brewfile.tmpl" | sha256sum }} {{ include ".chezmoidata/packages_brew.yaml" | sha256sum }} {{ include ".chezmoidata/packages_cask.yaml" | sha256sum }} {{ include ".chezmoidata/packages_flatpak.yaml" | sha256sum }}

main() {
    log_section "Installing Brewfile (Homebrew and Flatpak packages)"

    require_command brew "Homebrew package installation"

    run_spin "Updating Homebrew..." brew update
    log_info "Homebrew updated"

    run_spin "Installing packages..." brew bundle --file="{{ .chezmoi.homeDir }}/Brewfile"
    log_info "Brewfile installation completed"
    log_info "To remove unlisted packages, run: brew bundle cleanup --file={{ .chezmoi.homeDir }}/Brewfile"
}

main "$@"
