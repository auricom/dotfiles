{{- if eq .formFactor "workstation" }}
{{- includeTemplate "script-header" . }}
# NFS mounts configuration script
# Configures NFS mounts as systemd system mount units
# Data hash: {{ include ".chezmoidata/nfs.yaml" | sha256sum }}

NFS_SERVER_IP="{{ .nfs.server_ip }}"
SHARE_PREFIX="{{ .nfs.share_prefix }}"
MOUNTPOINT_PREFIX="{{ .nfs.mountpoint_prefix }}"
NFS_OPTS="{{ .nfs.options | replace ",x-systemd.automount" "" }}"
UNIT_DIR="/etc/systemd/system"
_needs_reload=false
declare -A DECLARED_MOUNT_POINTS=(
{{- range .nfs.mounts }}
    ["${MOUNTPOINT_PREFIX}/{{ .mountpoint }}"]=1
{{- end }}
)

remove_undeclared_mount_units() {
    local mount_unit mount_point unit_name

    for mount_unit in "${UNIT_DIR}"/*.mount; do
        [[ -f "$mount_unit" ]] || continue
        grep -qxF "Type=nfs" "$mount_unit" || continue

        mount_point=$(sed -n 's/^Where=//p' "$mount_unit")
        [[ "$mount_point" == "${MOUNTPOINT_PREFIX}/"* ]] || continue
        [[ -n "${DECLARED_MOUNT_POINTS[$mount_point]:-}" ]] && continue

        unit_name=${mount_unit##*/}
        log_info "Removing undeclared NFS mount unit: ${unit_name}"
        sudo systemctl disable --now "$unit_name"
        sudo rm -f -- "$mount_unit"
        _needs_reload=true

        if [[ -d "$mount_point" ]] && ! sudo rmdir -- "$mount_point"; then
            log_warn "Keeping non-empty mountpoint: ${mount_point}"
        fi
    done
}

install_mount_unit() {
    local share="$1"
    local mount_point="$2"

    local unit_name
    unit_name=$(systemd-escape --path "$mount_point")

    local mount_unit="${UNIT_DIR}/${unit_name}.mount"

    local mount_content="[Unit]
Description=NFS Mount ${mount_point}
Requires=network-online.target
After=network-online.target

[Mount]
What=${share}
Where=${mount_point}
Type=nfs
Options=${NFS_OPTS}

[Install]
WantedBy=multi-user.target"

    sudo mkdir -p "${mount_point}"

    local existing=""
    [[ -f "$mount_unit" ]] && existing=$(cat "$mount_unit")
    if [[ "$existing" != "$mount_content" ]]; then
        log_info "Writing mount unit: ${unit_name}.mount"
        echo "$mount_content" | sudo tee "$mount_unit" >/dev/null
        _needs_reload=true
    else
        log_info "Mount unit already up to date: ${unit_name}.mount"
    fi
}

reload_systemd_if_needed() {
    if [[ "$_needs_reload" != true ]]; then
        return
    fi

    log_info "Reloading systemd daemon"
    sudo systemctl daemon-reload
    _needs_reload=false
}

activate_mount_unit() {
    local mount_point="$1"

    local unit_name
    unit_name=$(systemd-escape --path "$mount_point")

    systemd_system_enable_start "${unit_name}.mount"
}

main() {
    log_section "Configuring NFS mounts"

    remove_undeclared_mount_units

{{- range .nfs.mounts }}
    install_mount_unit \
        "${NFS_SERVER_IP}:${SHARE_PREFIX}/{{ .share }}" \
        "${MOUNTPOINT_PREFIX}/{{ .mountpoint }}"
{{- end }}

    reload_systemd_if_needed

{{- range .nfs.mounts }}
    activate_mount_unit \
        "${MOUNTPOINT_PREFIX}/{{ .mountpoint }}"
{{- end }}

    log_info "NFS mounts configuration completed"
}

{{ includeTemplate "script-footer" . -}}
{{- end -}}
