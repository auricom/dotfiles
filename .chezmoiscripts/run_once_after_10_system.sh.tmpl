{{- if .isWorkstation }}
{{- includeTemplate "script-header" . }}
# System configuration script
# Configures system settings

main() {
    log_section "Configuring system settings"

    set_hostname
    deactivate_swap

    log_info "System configuration completed"
}

set_hostname() {
    local flag_file="{{ .chezmoi.homeDir }}/.local/state/chezmoi/hostname-set"

    if [[ -f "$flag_file" ]]; then
        log_info "Hostname already configured ($(cat "$flag_file")), skipping"
        return
    fi

    local current_hostname
    current_hostname=$(hostname)

    local new_hostname
    if ! new_hostname=$(prompt_input "Hostname" "${current_hostname}"); then
        log_warn "Hostname configuration skipped"
        return 0
    fi

    if [[ -z "$new_hostname" ]]; then
        log_warn "No hostname entered, skipping"
        return
    fi

    if sudo hostnamectl set-hostname "$new_hostname"; then
        log_info "Hostname set to: $new_hostname"
        mkdir -p "$(dirname "$flag_file")"
        echo "$new_hostname" >"$flag_file"
    else
        log_warn "Failed to set hostname"
    fi
}

deactivate_swap() {
    log_info "Checking system memory for swap configuration"

    # Check if swap is currently active
    if swapon --show | grep -q .; then
        log_info "Deactivating active swap"
        if sudo swapoff -a; then
            log_info "Successfully deactivated swap"
        else
            log_warn "Failed to deactivate swap"
            return
        fi
    else
        log_info "No active swap found"
    fi
}

{{ includeTemplate "script-footer" . -}}
{{- end -}}
