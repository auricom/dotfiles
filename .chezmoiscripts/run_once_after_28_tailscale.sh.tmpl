{{- if .isDesktop }}
{{- includeTemplate "script-header" . }}

# Enable and start tailscaled on workstations and laptops

main() {
    log_section "Activating tailscaled"

    if ! command_exists tailscaled; then
        log_warn "tailscaled not found, skipping"
        return 0
    fi

    systemd_system_enable_start tailscaled
    log_info "tailscaled activation completed"
}

main "$@"
{{- end -}}
