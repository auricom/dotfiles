{{- if .isWorkstation }}
{{- includeTemplate "script-header" . }}

# Configuration: {{ include "dot_config/mise/conf.d/dfiles.toml.tmpl" | sha256sum }}

main() {
    log_section "Installing DFiles from stable GitHub releases"
    "{{ .brewPrefix }}/bin/mise" install --yes github:duxlabs-dev/dux-files
    xdg-mime default dev.duxlabs.files.desktop inode/directory
}

{{ includeTemplate "script-footer" . -}}
{{- end -}}
