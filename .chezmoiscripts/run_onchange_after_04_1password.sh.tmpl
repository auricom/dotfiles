{{- if .isWorkstation }}
{{- includeTemplate "script-header" . }}
# Desktop entry: {{ include "dot_local/share/applications/1password.desktop" | sha256sum }}

main() {
    log_section "Configuring 1Password desktop integration"
    xdg-mime default 1password.desktop x-scheme-handler/onepassword
    xdg-mime default 1password.desktop x-scheme-handler/onepassword8
    update-desktop-database "{{ .chezmoi.homeDir }}/.local/share/applications"
    log_info "1Password desktop integration configured"
}

{{ includeTemplate "script-footer" . -}}
{{- end -}}
