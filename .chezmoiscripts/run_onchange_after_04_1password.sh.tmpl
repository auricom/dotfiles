{{- if .isDesktop }}
{{- includeTemplate "script-header" . }}

# Desktop entry: {{ include "dot_local/share/applications/com.onepassword.OnePassword.desktop.tmpl" | sha256sum }}

main() {
    xdg-mime default com.onepassword.OnePassword.desktop x-scheme-handler/onepassword
    xdg-mime default com.onepassword.OnePassword.desktop x-scheme-handler/onepassword8
    update-desktop-database "{{ .chezmoi.homeDir }}/.local/share/applications"
}

{{ includeTemplate "script-footer" . -}}
{{- end -}}
