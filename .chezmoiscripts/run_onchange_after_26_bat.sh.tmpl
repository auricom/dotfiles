{{- if .isDesktop }}
{{- includeTemplate "script-header" . }}

# bat cache rebuild script
# Rebuilds bat theme cache when Catppuccin themes change

# Hash dependencies: {{ include ".chezmoiexternals/catppuccin.toml.tmpl" | sha256sum }}

main() {
    log_section "Rebuilding bat theme cache"

    run_spin "Building bat theme cache..." bat cache --build
    log_info "bat cache rebuild completed"
}

{{ includeTemplate "script-footer" . -}}
{{- end -}}
