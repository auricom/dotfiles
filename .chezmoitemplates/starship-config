"$schema" = 'https://starship.rs/config-schema.json'

add_newline = true

format = """\
  $status\
  $username\
  $hostname\
  ${custom.git_host}\
  $shell\
  $directory\
  $git_branch\
  $fill\
  ${custom.since_last_commit}\
  $git_state\
  $git_metrics\
  $git_status\
  $git_commit\
  $cmd_duration\
  $character\
  """

palette = "catppuccin_{{ .flavor }}"

[shell]
disabled = false
fish_indicator = ''
bash_indicator = 'bash '
zsh_indicator = 'zsh '
format = '[$indicator]($style)'
style = 'bold red'

[character]
success_symbol = "\n[❯](bold green)"
error_symbol = "\n[❯](bold red)"

[container]
symbol='📦 '
format='[$symbol$name](bold peach dimmed) in '

[cmd_duration]
disabled = false
format = "[ ⏰ $duration]($style) "
min_time = 2_000
min_time_to_notify = 10000
show_notifications = false
style = "yellow"

[directory]
format = '[$path]($style)[$read_only]($read_only_style) '
repo_root_format = '([$path]($style) )([$read_only]($read_only_style) )'
repo_root_style = "accent"
style = "accent"
truncation_length = 0
truncate_to_repo = true
read_only = " "
fish_style_pwd_dir_length = 1
home_symbol = "~"

[directory.substitutions]
'/var/home/{{ .chezmoi.username }}' = '~'

[fill]
style = 'text'
symbol = " "
disabled = false

[status]
disabled = false
format = '[$symbol$status]($style) '
map_symbol = false
style = 'bold red'
success_symbol = ''
symbol = ' '

[git_branch]
disabled = false
format = '[$symbol$branch(:$remote_branch)]($style) '
symbol = " "
style = "text"

[git_commit]
disabled = false
commit_hash_length = 8
only_detached = false
style = "subtext0"
tag_symbol = " "

[git_status]
disabled = false
ahead = '[⇡${count}](lavender) '
behind = '😰 ${count}'
conflicted = '🏳'
deleted = '󰗨 ${count} '
diverged = '⇕⇡${ahead_count}⇣${behind_count} '
format = "[[($conflicted$modified$staged$renamed$deleted)](pink)($ahead_behind$stashed)]($style)"
modified = '[ ${count}](lavender) '
renamed = '👅'
staged = '[+$count](green) '
stashed = " ${count} "
style = "text"
untracked = "[ ${count}](sapphire) "
up_to_date = ''

[git_state]
cherry_pick = '[🍒PICK](red)'
format = '\([$state( $progress_current/$progress_total)]($style)\) '
style = "text"

[git_metrics]
disabled = false
format = '[+$added](green)[-$deleted](maroon) '
only_nonzero_diffs = true

[golang]
format = 'via [$symbol]($style)'

[hostname]
ssh_only = true
style = 'accent bold'
format = '[$ssh_symbol$hostname]($style) '

[helm]
format = 'via [$symbol]($style)'

[kubernetes]
disabled = true
symbol = "󱃾 "
format = "[\\[$symbol$context \\($namespace\\)\\]]($style) "
style  = "bold bright-green"

[nodejs]
format = 'via [$symbol]($style)'

{{ includeTemplate "catppuccin-palette-starship" (dict "name" (printf "catppuccin_%s" .flavor) "colors" (index .catppuccin.palette .flavor) "accent" .catppuccin.accent) }}

[python]
disabled = false
format = 'via [$symbol]($style)'
symbol = " "

[username]
disabled = false
show_always = false
style_root = "bold red"
format = "[$user]($style) "

[custom.since_last_commit]
command = """{{ joinPath .chezmoi.homeDir ".local/bin/relative-time-commit" }}"""
description = "Show time since last commit"
directories = [".git"]
format = "[󰚰 $output]($style) "
shell = ["bash", "--norc", "--noprofile"]
style = "accent"
when = 'git rev-parse --is-inside-work-tree 2> /dev/null'

[custom.git_host]
command = """{{ joinPath .chezmoi.homeDir ".local/bin/github-icon" }}"""
description = "Show icon of git host platform"
directories = [".git"]
format = "[$output]($style) "
shell = ["bash", "--norc", "--noprofile"]
style = "accent"
when = 'git rev-parse --is-inside-work-tree 2> /dev/null'

[custom.dir]
command = """{{ joinPath .chezmoi.homeDir ".local/bin/fishfy-path" }}"""
description = "Custom directory"
format = "[$output]($style) "
shell = ["bash", "--norc", "--noprofile"]
style = "accent"
when = 'true'
