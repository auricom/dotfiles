{{- /* One-shot user systemd unit scaffold.
Args: description, after (list), wants (optional), condition (optional),
      exec (command or list of sequential commands),
      path (PATH value, typically includeTemplate "brew-path" | trim). */ -}}
[Unit]
Description={{ .description }}
{{- range .after }}
After={{ . }}
{{- end }}
{{- with index . "wants" }}
Wants={{ . }}
{{- end }}
{{- with index . "condition" }}
ConditionPathExists={{ . }}
{{- end }}
OnFailure=notify-failure@%p.service

[Service]
Type=oneshot
{{- if kindIs "slice" .exec }}
{{- range .exec }}
ExecStart={{ . }}
{{- end }}
{{- else }}
ExecStart={{ .exec }}
{{- end }}
Environment="PATH={{ .path }}"

[Install]
WantedBy=default.target
