{{- /* One-shot user systemd unit scaffold.
Args: description, after (optional list), wants (optional), condition (optional),
      execPre (optional command or list; runs before exec),
      exec (command or list of sequential commands),
      note (optional comment in the service section),
      timeout (optional TimeoutStartSec),
      path (PATH value, typically includeTemplate "brew-path" | trim).
User units cannot order on the system network-online.target. Callers that need
the network pass execPre "/usr/bin/nm-online --quiet --timeout=30". */ -}}
[Unit]
Description={{ .description }}
{{- range index . "after" }}
After={{ . }}
{{- end }}
{{- with index . "wants" }}
Wants={{ . }}
{{- end }}
{{- with index . "condition" }}
ConditionPathExists={{ . }}
{{- end }}
OnFailure=notify-failure@%p.service

[Service]
Type=oneshot
{{- with index . "execPre" }}
{{- if kindIs "slice" . }}
{{- range . }}
ExecStartPre={{ . }}
{{- end }}
{{- else }}
ExecStartPre={{ . }}
{{- end }}
{{- end }}
{{- if kindIs "slice" .exec }}
{{- range .exec }}
ExecStart={{ . }}
{{- end }}
{{- else }}
ExecStart={{ .exec }}
{{- end }}
Environment="PATH={{ .path }}"
{{- with index . "note" }}
# {{ . }}
{{- end }}
{{- with index . "timeout" }}
TimeoutStartSec={{ . }}
{{- end }}

[Install]
WantedBy=default.target
